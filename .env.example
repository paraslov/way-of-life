# Local PostgreSQL started with `pnpm db:up`.
DATABASE_URL=postgresql://mylife_app:mylife_app_local_password@localhost:5435/mylife
DATABASE_ADMIN_URL=postgresql://mylife_admin:mylife_admin_local_password@localhost:5435/mylife
AUTH_THROTTLE_SECRET=local-development-secret-replace-in-production

# In Vercel, DATABASE_URL must use a NOSUPERUSER/NOBYPASSRLS runtime role.
# DATABASE_ADMIN_URL is the direct privileged URL used only by CLI migrations
# and account provisioning; it must not be available to the Next.js runtime.
# AUTH_THROTTLE_SECRET must be a production-only random value of at least
# 32 characters, for example: `openssl rand -base64 32`.
